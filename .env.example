# Copy this file to .env.local for development. Never commit .env.local.
# Use a local SQLite file for development only.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Generate a unique secret with the command in README.md (minimum 32 characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# For Vercel, enter these in the project's server environment settings:
# TURSO_DATABASE_URL=libsql://YOUR-DATABASE-HOST.turso.io
# TURSO_AUTH_TOKEN=YOUR_DATABASE_TOKEN
# BETTER_AUTH_SECRET=YOUR_UNIQUE_RANDOM_SECRET
# BETTER_AUTH_URL=https://YOUR-PRODUCTION-DOMAIN
# Do not use NEXT_PUBLIC_ prefixes for any of these variables.
